# Required in every environment. Generate a random value of at least 32 characters.
DENTIC_JWT_SECRET=replace-with-a-random-secret

# Local-only settings. Keep COOKIE_SECURE=true behind HTTPS in production.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_H2_CONSOLE_ENABLED=false
COOKIE_SECURE=false

# Required before enabling real provider webhooks.
WHATSAPP_WEBHOOK_SECRET=replace-with-whatsapp-secret
BILLING_WEBHOOK_SECRET=replace-with-billing-secret
