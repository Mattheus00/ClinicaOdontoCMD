# Carregue estas variáveis no ambiente de execução; o Spring não lê arquivos .env sozinho.
SPRING_PROFILES_ACTIVE=supabase

# Session Pooler do Supabase (porta 5432), recomendado para este backend Spring persistente.
# Copie os valores em Dashboard > Connect. Nunca envie a senha ao Git.
SUPABASE_DB_JDBC_URL=jdbc:postgresql://aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=replace-with-the-supabase-database-password
SUPABASE_DB_POOL_SIZE=5

# Use true apenas na primeira inicialização deste projeto, depois de aplicar o schema via MCP.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=13

# Segredos já exigidos pela aplicação.
DENTIC_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=true
WHATSAPP_WEBHOOK_SECRET=replace-with-whatsapp-secret
BILLING_WEBHOOK_SECRET=replace-with-billing-secret
